# Copy to .env and fill in. Never commit or share .env.
# Do NOT put AWS access keys here - use an AWS CLI profile (SSO or role) instead.

AWS_PROFILE=aws-finops-agent
AWS_REGION=us-east-1

# Streamable HTTP mode only. Host must stay on localhost.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Required for streamable-http. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# CloudWatch Logs / CloudTrail tools can expose sensitive data. Off by default.
FINOPS_ENABLE_LOG_TOOLS=false
